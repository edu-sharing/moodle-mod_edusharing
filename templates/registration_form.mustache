{{!
    @template mod_edusharing/registration_form

    The form to register the plugin with the repository whose metadata were imported (import_metadata.php).

    Context variables required for this template:
    * sesskey - The session key
    * repourl - The repository's url from its metadata
    * appid - This Moodle's app id
    * hostaliases - This Moodle's host aliases

    Example context (json):
    {
        "sesskey": "abc123",
        "repourl": "https://repository.example.com/edu-sharing/",
        "appid": "moodle_123",
        "hostaliases": ""
    }
}}
<form class="repo-reg mb-4" action="import_metadata.php" method="post">
    <h3>{{#str}} registration_form_heading, mod_edusharing {{/str}}</h3>
    <p>{{#str}} registration_form_proxy_hint, mod_edusharing {{/str}}</p>
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <div class="mb-3">
        <label for="edusharing_repourl">{{#str}} registration_repo_url, mod_edusharing {{/str}}</label>
        <input type="text" id="edusharing_repourl" name="repoUrl" class="form-control" value="{{repourl}}">
    </div>
    <div class="mb-3">
        <label for="edusharing_repoadmin">{{#str}} registration_repo_admin, mod_edusharing {{/str}}</label>
        <input type="text" id="edusharing_repoadmin" name="repoAdmin" class="form-control">
    </div>
    <div class="mb-3">
        <label for="edusharing_repopwd">{{#str}} registration_repo_password, mod_edusharing {{/str}}</label>
        <input type="password" id="edusharing_repopwd" name="repoPwd" class="form-control">
    </div>
    <div class="mb-3">
        <label for="edusharing_appid">{{#str}} registration_app_id, mod_edusharing {{/str}}</label>
        <input type="text" id="edusharing_appid" name="appId" class="form-control" value="{{appid}}">
    </div>
    <div class="mb-3">
        <label for="edusharing_hostaliases">{{#str}} registration_host_aliases, mod_edusharing {{/str}}</label>
        <input type="text" id="edusharing_hostaliases" name="host_aliases" class="form-control" value="{{hostaliases}}">
    </div>
    <button type="submit" class="btn btn-primary" name="repoReg" value="1">{{#str}} registration_submit, mod_edusharing {{/str}}</button>
</form>
